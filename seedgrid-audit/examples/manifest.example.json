{
  "schema_version": 1,
  "project": "Multimodal experiment reproducibility check",
  "root": "../runs",
  "axes": {
    "model": ["baseline-a", "ours"],
    "dataset": ["dataset-a", "dataset-b"],
    "seed": [13, 21, 42]
  },
  "artifacts": {
    "checkpoint": {
      "path": "{model}/{dataset}/seed-{seed}/best.pt",
      "min_bytes": 1024
    },
    "metrics": {
      "path": "{model}/{dataset}/seed-{seed}/metrics.json",
      "kind": "json",
      "required_numeric": {
        "accuracy": {"min": 0, "max": 1},
        "macro_f1": {"min": 0, "max": 1}
      }
    }
  }
}
